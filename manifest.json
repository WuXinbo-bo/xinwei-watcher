{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "Xinwei Course Watcher",
  "version": "1.1.0",
  "version_name": "1.1.0",
  "description": "Plays unfinished course videos and audio normally, with clear completion and pause controls.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.beeline-ai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.beeline-ai.com/student/*",
        "https://www.beeline-ai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Xinwei Course Watcher"
  }
}
