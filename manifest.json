{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "芯位教育助手",
  "version": "1.2.0",
  "version_name": "1.2.0",
  "description": "Plays unfinished course videos and audio normally, with clear completion and pause controls.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.beeline-ai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.beeline-ai.com/student/*",
        "https://www.beeline-ai.com/*"
      ],
      "js": [
        "assistant-ui.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "assistant-ui.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/floating-assistant.png"
      ],
      "matches": [
        "https://www.beeline-ai.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "芯位教育助手"
  }
}
